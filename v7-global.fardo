{
  "version": "2.0.0",
  "projectName": "Cuentas Multi-Platform Deployment",
  "outputDir": "C:\\AutoItBuilds\\Output",
  "namingPattern": "Build_{{ gamename }}_Cab{{ id }}.exe",
  "timerBasePath": "C:\\Timers",
  "platforms": {
    "epic": {
      "launcher": "C:\\Program Files (x86)\\Epic Games\\Launcher\\Engine\\Binaries\\Win64\\EpicGamesLauncher.exe",
      "gameBasePath": "C:\\EpicBats",
      "gameExt": ".bat",
      "games": [
        "RocketLeague",
        "Fallguys",
        "Fortnite"
      ],
      "templateCode": "||| filename = Build_{{ gamename }}_Cab{{ id }}.exe\n#cs ----------------------------------------------------------------------------\n Block 1: Main Launcher Executable (cuentas-epic.ps1)\n Compatible placeholders: {{ user }}, {{ password }}, {{ shortwait }}, {{ gamepath }}, {{ launcher }}, {{ timer }}, {{ prepasswait }}, {{ postpasswait }}\n Note: waitone is automatically calculated as (shortwait + 1) seconds\n#ce ----------------------------------------------------------------------------\n\n#RequireAdmin\nIf ProcessExists(\"EpicGamesLauncher.exe\") Then\n    BlockInput(1)\n    ProcessClose(\"Steam.exe\")\n    Sleep(100) \n    Run(\"{{ gamepath }}\")\n    BlockInput(0)\n    Exit\nElse\n    ; Run the executable\n    BlockInput(1)\n    ProcessClose(\"Steam.exe\")\n    Sleep(200)\n    Run(\"{{ timer }}\")\n    Run(\"{{ launcher }}\")\n    Sleep(1500)\n    Run(\"{{ gamepath }}\") ; abre el bat en el lugar que le designas\n    Sleep(500)\n    Sleep(({{ shortwait }} + 1) * 1000) ; tiempo de espera principal (shortwait + 1s convertido a ms)\n    WinActivate(\"[CLASS:UnrealWindow]\")\n    Sleep(500)\n    WinSetState(\"[CLASS:UnrealWindow]\", \"\", @SW_MAXIMIZE)\n    Sleep(300)\n\n    ; Primer movimiento mouse con puesta de cuenta \n    MouseMove(940, 250)\n    MouseClick(\"left\")\n    Sleep(25)\n    Send(\"^a\")\n    Sleep(25)\n    Send(\"{DELETE}\")\n    Sleep(50)\n    Send(\"{{ user }}\")\n    Sleep(100)\n    Send(\"{ENTER}\")\n    Sleep({{ prepasswait }} * 1000)\n\n    ; Segundo movimiento de mouse donde va contraseña\n    MouseMove(820, 550)\n    MouseClick(\"left\")\n    Sleep(500)\n    MouseClick(\"left\")\n    Send(\"^a\")\n    Sleep(25)\n    Send(\"{DELETE}\")\n    Send(\"{{ password }}\")\n    Sleep(15)\n    Send(\"{ENTER}\")\n    Sleep(7025)\n    MouseMove(820, 745)\n    MouseClick(\"left\")\n    Sleep(2525)\n    Run(\"{{ gamepath }}\")\n    BlockInput(0)\n    Exit\nEndIf\n\n||| filename = TimerDeCab{{ id }}.exe\n#cs ----------------------------------------------------------------------------\n Block 2: On-Screen Countdown GUI Timer (TIMERS2.ps1)\n Compatible placeholders: {{ shortwait }}, {{ id }}\n Note: shortwait is in seconds\n#ce ----------------------------------------------------------------------------\n\n#RequireAdmin\n#include <GUIConstantsEx.au3>\n#include <MsgBoxConstants.au3>\n\n; Create the main GUI window\n$hGUI = GUICreate(\"Temporizador\", 300, 150, -1, -1)\n\n; Create label for timer display\n$lblTimer = GUICtrlCreateLabel(\"ESPERAR {{ shortwait }} SEGUNDOS!\", 50, 30, 200, 20)\nGUICtrlSetFont($lblTimer, 12, 600)\n\n; Create message label\n$lblMessage = GUICtrlCreateLabel(\"Esperar a que la cuenta se ponga sola\", 50, 60, 200, 20)\n\n; Create OK button\n$btnOK = GUICtrlCreateButton(\"OK\", 100, 100, 80, 30)\n\n; Show the GUI\nGUISetState(@SW_SHOW, $hGUI)\n\n; Set the window to always stay on top\nWinSetOnTop(\"Temporizador\", \"\", 1)\n\n; Set initial timer value in seconds\n$iTimer = {{ shortwait }}\n$hTimer = TimerInit()\n\n; Main loop\nWhile 1\n    ; Check if 1 second has passed\n    If TimerDiff($hTimer) >= 1000 Then\n        $iTimer -= 1\n        GUICtrlSetData($lblTimer, \"Tiempo restante: \" & $iTimer & \" segundos\")\n        $hTimer = TimerInit()\n        \n        ; If timer reaches 0, close the dialog\n        If $iTimer <= 0 Then\n            GUICtrlSetData($lblTimer, \"Listo!\")\n            Sleep(250)\n            ExitLoop\n        EndIf\n    EndIf\n    \n    ; Check for GUI events\n    $nMsg = GUIGetMsg()\n    Switch $nMsg\n        Case $GUI_EVENT_CLOSE, $btnOK\n            ExitLoop\n    EndSwitch\n    \n    ; Small sleep to prevent high CPU usage\n    Sleep(25)\nWEnd\n\n; Clean up\nGUIDelete($hGUI)\n"
    },
    "ea": {
      "launcher": "C:\\Program Files\\Electronic Arts\\EA Desktop\\EA Desktop\\EALauncher.exe",
      "gameBasePath": "C:\\EAccesos",
      "gameExt": ".lnk",
      "games": [
        "Battlefield V",
        "FIFA 25"
      ],
      "templateCode": "||| filename = Build_{{ gamename }}_Cab{{ id }}.exe\n#RequireAdmin\nMsgBox(0, \"EA Target\", \"EA Launch target stub\")"
    }
  },
